{"id": "tatoeba-1923a49dabd5f91c", "text": "Mbaka nikwataa mbia.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "Cats catch mice.", "translation_lang": "eng"}
{"id": "tatoeba-e9b467474a82bdfa", "text": "Huu niw'o usi wa katatu munene nduniani.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "This is the third longest river in the world.", "translation_lang": "eng"}
{"id": "tatoeba-e95c3b84c8940817", "text": "Mwaitu atũmie valũa hũũ kwacha.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "My grandmother posted the letter this morning.", "translation_lang": "eng"}
{"id": "tatoeba-742712ae31cf3ac8", "text": "Nuthambisye ngali?", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "Have you washed the car yet?", "translation_lang": "eng"}
{"id": "tatoeba-a236386191a33ea1", "text": "Niniendete ngiti.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "I like dogs.", "translation_lang": "eng"}
{"id": "tatoeba-fd2ecc357555304c", "text": "Ũvoo!", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "Hello!", "translation_lang": "eng"}
{"id": "tatoeba-d2ec92bf7e8e09db", "text": "Ngiti nisyiukuma.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "Dogs are barking.", "translation_lang": "eng"}
{"id": "tatoeba-9c5ce2c11f7bcf41", "text": "Mbaka hĩĩ nĩ yakwa.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "This is my cat.", "translation_lang": "eng"}
{"id": "tatoeba-9658916119ba863f", "text": "Tom niwe munene waku.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "Tom is your boss.", "translation_lang": "eng"}
{"id": "tatoeba-f3bf8973e734a160", "text": "Ngali ya mwaki isovetw'e na ngali mũonza.", "source": "tatoeba", "url": "https://object.pouta.csc.fi/OPUS-Tatoeba/v2026-07-08/moses/en-kam.txt.zip", "license": "CC-BY-2.0-FR", "genre": "conversational", "lang": "kam", "date_fetched": "2026-09-26", "lang_declared": "kam", "translation": "The train is made up of seven cars.", "translation_lang": "eng"}
